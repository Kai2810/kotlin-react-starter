{
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(**/.env)", "Read(**/.env.*)"],
    "ask": ["Bash(git push:*)", "Bash(gh pr create:*)", "Bash(npm install:*)"],
    "allow": [
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(./gradlew test:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)"
    ]
  }
}
